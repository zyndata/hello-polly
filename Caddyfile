# Caddy serves the prebuilt SPA as static files. It listens on plain HTTP :8081 (:8080 is Eat
# My Way on the same host); in production nginx terminates TLS for hellopolly.gorny.dev and
# proxies here. Caddy is the single source of the security headers. nginx must not add its
# own, or browsers receive duplicates.

{
	admin off
	auto_https off
	servers {
		# nginx sits in front; without this Caddy would log the proxy's address.
		trusted_proxies static private_ranges
	}
}

:8081 {
	root * /srv
	encode zstd gzip

	header {
		# No 'unsafe-inline' and no 'unsafe-eval', ever. This origin only, plus two hosts:
		#   script-src https://static.cloudflareinsights.com: the Cloudflare Web Analytics
		#     beacon, which the zone injects into this document at the edge. It reports to
		#     /cdn-cgi/rum on this same origin, so connect-src needs nothing for it.
		#   img-src https://cdn.jsdelivr.net (Phase 2, STATE.md decision 13): the content
		#     pictures, served from this public repository at the release tag.
		#   https://accounts.google.com in script-src and frame-src, https://www.googleapis.com
		#     in connect-src (Phase 7, STATE.md decision 73): Google Identity Services, loaded
		#     only when a parent connects Drive, and the Drive API (uploads included).
		#   https://apis.google.com in script-src, https://docs.google.com in frame-src
		#     (Phase 8, STATE.md decision 81): the Google Picker's loader and its frame, loaded
		#     only when an invited parent joins. Measured against the real Picker: nothing else
		#     is needed. Its loader also injects an inline <style>, which style-src blocks on
		#     purpose; the same rules live in app.css.
		# Every widening is recorded in STATE.md and verified under `npm run docker:up`.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://accounts.google.com https://apis.google.com; style-src 'self'; img-src 'self' https://cdn.jsdelivr.net; font-src 'self'; connect-src 'self' https://www.googleapis.com; worker-src 'self'; manifest-src 'self'; frame-src https://accounts.google.com https://docs.google.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
		# GIS hands the token back through the sign-in popup's opener, which `same-origin`
		# would sever (STATE.md decision 73).
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		X-Content-Type-Options "nosniff"
		# The Picker's key is restricted to this site's referrers, so Google must see the origin
		# (never the path; the #/route is never sent anyway). STATE.md decision 99.
		Referrer-Policy "strict-origin"
		# Nothing records the child: the microphone and the camera are denied outright.
		Permissions-Policy "accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), interest-cohort=(), magnetometer=(), microphone=(), payment=(), usb=()"
		# Version and stack are nobody's business.
		-Server
	}

	# Hashed bundle assets are immutable; the entry document never is. Matched on the
	# requested path, before try_files rewrites a deep link to index.html.
	@immutable path /assets/*
	@document not path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header @document Cache-Control "no-cache"

	# Routing is hash-based, so this only catches typo'd paths. Everything resolves to the
	# one document.
	try_files {path} /index.html
	file_server
}
