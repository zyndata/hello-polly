{
  "name": "hello-polly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "English vocabulary for pre-reading children: a client-side PWA with a Polish UI.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:csp": "playwright test --config playwright.csp.config.ts",
    "docker:up": "npm run build && docker compose down && docker compose up --build -d",
    "screenshots": "node scripts/screenshots.mjs",
    "changelog": "git-cliff --config cliff.toml -o CHANGELOG.md"
  },
  "dependencies": {
    "bits-ui": "2.19.0",
    "svelte-spa-router": "5.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "git-cliff": "2.13.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
