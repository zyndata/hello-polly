# Copy to .env.local for development. Never commit a real .env file.
#
# Vite exposes every VITE_* variable to the browser bundle. Only put values here that are safe
# to publish. This app has no secrets by design: there is no API key of the owner's anywhere.
# If a keyed speech engine is ever added, the key is the parent's own and lives in the family
# settings at runtime, never here.
#
# None of these is read before Phase 7 (Drive sync) and Phase 8 (the Google Picker).

# Google OAuth client ID (scope drive.file). Public by design: it ships inside the SPA.
# Authorized JavaScript origins: http://localhost:5173, http://localhost:8081 and
# https://hellopolly.gorny.dev.
VITE_GOOGLE_CLIENT_ID=

# Browser API key for the Google Picker. Public by design; restrict it in Google Cloud to the
# Picker API and to the app's referrers.
VITE_GOOGLE_API_KEY=

# Google Cloud project number ("app id"), which the Picker needs. Public by design.
VITE_GOOGLE_APP_ID=
